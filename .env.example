# Application
NODE_ENV=development
APP_NAME=RBMaison
PORT=3000
API_PREFIX=api/v1

# CORS — production must be an explicit frontend origin, never *
CORS_ENABLED=true
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Supabase — copy from Dashboard → Project Settings → API
# Local CLI defaults:
#   SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret is required in production. Never expose it or SUPABASE_SERVICE_ROLE_KEY to clients.
SUPABASE_JWT_SECRET=
