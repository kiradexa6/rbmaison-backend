# Application
NODE_ENV=development
APP_NAME=RBMaison
PORT=3000
API_PREFIX=api/v1

# CORS — production must be an explicit frontend origin, never *
CORS_ENABLED=true
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Supabase — MUST match the live Lovable / rbmaisons.com project (single production database)
# Hosted project ref: sbcyoaswsjfhhkypdniu
# URL (not a secret): https://sbcyoaswsjfhhkypdniu.supabase.co
#
# Use the SAME anon key as the Lovable frontend. Never point production at 127.0.0.1:54321.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=sbcyoaswsjfhhkypdniu
# JWT secret is required in production. Never expose it or SUPABASE_SERVICE_ROLE_KEY to clients.
SUPABASE_JWT_SECRET=

# Optional — used by `npm run verify:production-db` only (never commit passwords)
# VERIFY_USER_EMAIL=
# VERIFY_USER_PASSWORD=

# Admin historical data generator — per-run ceilings (SQL also enforces these)
HISTORICAL_MAX_DAYS=180
HISTORICAL_MAX_DEPOSITS=40
HISTORICAL_MAX_WITHDRAWALS=20
HISTORICAL_MAX_ORDERS=60
HISTORICAL_MAX_WALLET_TRANSACTIONS=200
HISTORICAL_MAX_TOTAL_ROWS=400
