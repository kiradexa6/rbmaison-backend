# Application
NODE_ENV=development
APP_NAME=RBMaison
PORT=3000
API_PREFIX=api/v1

# CORS — production must be an explicit frontend origin, never *
CORS_ENABLED=true
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Supabase — MUST match the live Lovable / rbmaisons.com project (single production database)
# Live Lovable project ref: elvypbekopexhcojpwki
# URL (not a secret): https://elvypbekopexhcojpwki.supabase.co
#
# Use the SAME anon key as the Lovable frontend. Never point production at 127.0.0.1:54321.
# Do NOT use sbcyoaswsjfhhkypdniu — that is a separate empty project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=elvypbekopexhcojpwki
# JWT secret is required in production. Never expose it or SUPABASE_SERVICE_ROLE_KEY to clients.
SUPABASE_JWT_SECRET=

# Optional — used by `npm run verify:production-db` only (never commit passwords)
# VERIFY_USER_EMAIL=
# VERIFY_USER_PASSWORD=

# Optional — used by `npm run verify:control-center`
# API_URL=https://rbmaison-backend-production-f5dd.up.railway.app
# VERIFY_ADMIN_EMAIL=
# VERIFY_ADMIN_PASSWORD=
# VERIFY_TARGET_USER_ID=

# Admin historical data generator — per-run ceilings (SQL also enforces these)
HISTORICAL_MAX_DAYS=180
HISTORICAL_MAX_DEPOSITS=40
HISTORICAL_MAX_WITHDRAWALS=20
HISTORICAL_MAX_ORDERS=60
HISTORICAL_MAX_WALLET_TRANSACTIONS=200
HISTORICAL_MAX_TOTAL_ROWS=400

# Stripe — customer card checkout for existing orders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
